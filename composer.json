{
    "name": "cocoon/cocoon-master",
    "description": "Cocoon WordPress Theme - Unit Tests",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "yoast/phpunit-polyfills": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Cocoon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --exclude-group distribution",
        "test:unit": "phpunit --testsuite unit --exclude-group distribution",
        "test:distribution": "phpunit --group distribution",
        "test:integration": "phpunit -c phpunit.integration.xml --testsuite integration",
        "test:coverage": "phpunit --testsuite unit --exclude-group distribution --coverage-html tests/coverage --coverage-text",
        "test:coverage-clover": "phpunit --testsuite unit --exclude-group distribution --coverage-clover tests/coverage/clover.xml --coverage-text"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
