{
  "name": "cocoon-master",
  "version": "2.5.42",
  "private": true,
  "description": "",
  "author": "yhira",
  "license": "GPL-2.0-or-later",
  "homepage": "https://wp-cocoon.com/",
  "repository": "https://github.com/xserver-inc/cocoon",
  "bugs": {
    "url": "https://github.com/xserver-inc/cocoon/issues"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.9.0 <7"
  },
  "dependencies": {
    "@wordpress/prettier-config": "^2.6.0"
  },
  "overrides": {
    "underscore": "^1.13.7",
    "minimatch@<4": "^3.1.3",
    "minimatch@9": "^9.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prettier/plugin-php": "^0.19.1",
    "@wordpress/eslint-plugin": "^16.0.0",
    "eslint": "^8.57.0",
    "gettext-parser": "1.1.0",
    "gulp": "^5.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^5.1.0",
    "lighthouse": "^13.4.1",
    "jsdom": "^20.0.3",
    "po2json": "^0.4.5",
    "postcss": "^8.5.23",
    "postcss-scss": "^4.0.9",
    "prettier": "npm:wp-prettier@^2.6.2",
    "run-script-os": "^1.1.6",
    "sass": "^1.69.5",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-scss": "^6.0.0"
  },
  "scripts": {
    "watch": "gulp watch",
    "start": "cd blocks && npm run start",
    "prod": "gulp",
    "build": "gulp && cd blocks && npm run build",
    "compile-mo": "node scripts/compile-po.js",
    "compile-blocks-json": "node scripts/compile-blocks-json.js",
    "add-blocks-translations": "node scripts/add-blocks-translations.js",
    "compile-l10n-php": "php vendor/bin/wp-cli.phar i18n make-php languages/",
    "compile-all": "npm run compile-mo && npm run compile-l10n-php && npm run compile-blocks-json && npm run add-blocks-translations",
    "make-pot": "node scripts/setup-wpcli.js",
    "update-po": "node scripts/update-po.js",
    "sync-i18n-corrections": "node scripts/sync-i18n-audit-catalog.js",
    "po2json": "run-script-os",
    "po2json:windows": "po2json -f jed1.x languages/%npm_config_locale%.po languages/cocoon-%npm_config_locale%-cocoon-blocks-js.json",
    "po2json:nix": "./node_modules/po2json/bin/po2json -f jed1.x languages/${npm_config_locale}.po languages/cocoon-${npm_config_locale}-cocoon-blocks-js.json",
    "test": "npm run test:php && npm run test:settings-navigation && npm run test:settings-css && npm run test:i18n && npm run test:widget-borders && npm run test:skin-colors",
    "test:php": "composer test",
    "test:settings-navigation": "node tests/js/cocoon-settings-navigation.test.js",
    "test:settings-css": "node tests/js/cocoon-settings-css-build.test.js",
    "test:release": "npm run lint:settings && npm run test:settings-navigation && npm run test:settings-css && npm run test:i18n && npm run test:widget-borders && npm run test:skin-colors && composer test:distribution",
    "test:skin-colors": "node tests/js/one-skin-colors.test.js",
    "test:widget-borders": "node tests/js/widget-entry-borders.test.js",
    "test:widget-borders-browser": "playwright test tests/e2e/widget-entry-borders.spec.js",
    "test:unit": "composer test:unit",
    "test:i18n": "node scripts/test-i18n.js",
    "test:click-js": "node tests/js/click-analytics.test.js && node tests/js/analytics-suggest.test.js && node tests/js/map-post-picker.test.js && node tests/js/click-stat-tips.test.js && node tests/js/click-table-scroll.test.js",
    "test:click-browser": "playwright test tests/e2e/click-analytics.spec.js tests/e2e/click-analytics-performance.spec.js tests/e2e/click-analytics-map.spec.js tests/e2e/map-post-picker.spec.js tests/e2e/click-stat-tips.spec.js tests/e2e/click-pagination.spec.js tests/e2e/click-sorting.spec.js tests/e2e/click-table-scroll.spec.js",
    "test:click-lighthouse": "node tests/performance/click-analytics-lighthouse.mjs",
    "lint:settings": "eslint js/cocoon-settings-navigation.js tests/js/cocoon-settings-navigation.test.js tests/js/cocoon-settings-css-build.test.js && stylelint scss/_cocoon-settings-modern.scss",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:js:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:css": "stylelint **/*.{css,scss,sass}",
    "lint:css:fix": "stylelint **/*.{css,scss,sass} --fix",
    "lint:php": "phpcs -d memory_limit=512M --standard=WordPress --ignore=*/node_modules/*,*/vendor/*,*/blocks/* --extensions=php .",
    "lint:php:fix": "phpcbf -d memory_limit=512M --standard=WordPress --ignore=*/node_modules/*,*/vendor/*,*/blocks/* --extensions=php .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
